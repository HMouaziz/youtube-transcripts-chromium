{
  "manifest_version": 3,
  "name": "YouTube Transcript Download",
  "version": "1.1.3",
  "description": "Download captions from the current YouTube video as text, JSON, or subtitles.",
  "minimum_chrome_version": "103",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging",
    "declarativeContent",
    "tabs"
  ],
  "background": {
    "service_worker": "background-v2.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Download YouTube transcript",
    "default_icon": {
      "16": "icons/disabled-16.png",
      "32": "icons/disabled-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
